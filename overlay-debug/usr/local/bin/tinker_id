#!/bin/bash

FILEPATH=/sys/devices/platform/ff100000.saradc/iio:device0

function usage {
    echo "command example:"
    echo "tinker_id cpu_ddr: get CPU memory size"
    echo "tinker_id npu_ddr: get NPU memory size"
    echo "tinker_id swid: get Software ID"
    echo "tinker_id bid:  get Board ID"
    exit 1
}

function check {
    voltage_raw=$1
    voltage_result=$(echo "$voltage_scale*$voltage_raw" | bc)
    Vboard_id=5

    if [ $(echo "$voltage_result > 1600" | bc) -eq 1 -a $(echo "$voltage_result < 2000" | bc) -eq 1 ]; then
        Vboard_id=2
    fi

    if [ $(echo "$voltage_result > 700" | bc) -eq 1 -a $(echo "$voltage_result < 1100" | bc) -eq 1 ]; then
        Vboard_id=1
    fi

    if [ $(echo "$voltage_result < 200" | bc) -eq 1 ]; then
        Vboard_id=0
    fi

    return "$Vboard_id"
}

function check_bid {
    voltage_raw=$1
    voltage_result=$(echo "$voltage_scale*$voltage_raw" | bc)
    Vboard_id=5

    if [ $(echo "$voltage_result > 1700" | bc) -eq 1 -a $(echo "$voltage_result < 1900" | bc) -eq 1 ]; then
        Vboard_id=4
    fi

    if [ $(echo "$voltage_result > 1100" | bc) -eq 1 -a $(echo "$voltage_result < 1300" | bc) -eq 1 ]; then
        Vboard_id=3
    fi

    if [ $(echo "$voltage_result > 800" | bc) -eq 1 -a $(echo "$voltage_result < 1000" | bc) -eq 1 ]; then
        Vboard_id=2
    fi

    if [ $(echo "$voltage_result > 500" | bc) -eq 1 -a $(echo "$voltage_result < 700" | bc) -eq 1 ]; then
        Vboard_id=1
    fi

    if [ $(echo "$voltage_result < 100" | bc) -eq 1 ]; then
        Vboard_id=0
    fi

    return "$Vboard_id"
}

function unknown {
    echo "unknown version"
    exit 1
}

if [ "$#" -eq 1 ]; then
    PARA=$1
    voltage_scale=$(<$FILEPATH/in_voltage_scale)

    case $PARA in
    cpu_ddr)
        voltage_raw=$(<$FILEPATH/in_voltage0_raw)
        check $voltage_raw
        ret_Vid=$?

        case $ret_Vid in
        2)
            echo "2G"
            ;;
        1)
            echo "4G"
            ;;
        0)
            echo "reserve"
            ;;
        *)
            unknown
            ;;
        esac
        exit 1
        ;;
    npu_ddr)
        voltage_raw=$(<$FILEPATH/in_voltage1_raw)
        check $voltage_raw
        ret_Vid=$?

        case $ret_Vid in
        2)
            echo "1G"
            ;;
        1)
            echo "2G"
            ;;
        0)
            echo "reserve"
            ;;
        *)
            unknown
            ;;
        esac
        exit 1
        ;;
    swid)
        voltage_raw=$(<$FILEPATH/in_voltage4_raw)
        check $voltage_raw
        ret_Vid=$?

        case $ret_Vid in
        2)
            echo "reserve"
            ;;
        1)
            echo "reserve"
            ;;
        0)
            echo "reserve"
            ;;
        *)
            echo "reserve"
            ;;
        esac
        exit 1
        ;;
    bid)
        voltage_raw=$(<$FILEPATH/in_voltage5_raw)
        check_bid $voltage_raw
        ret_Vid=$?

        case $ret_Vid in
        4)
            echo "1.02"
            ;;
        3)
            echo "1.04"
            ;;
        2)
            echo "1.01"
            ;;
        1)
	    echo "1.05"
	    ;;
        0)
            echo "1.03"
            ;;
        *)
            unknown
            ;;
        esac
        exit 1
        ;;
    *)
        echo "Unsupported parameter"
        usage
        ;;
    esac
fi

usage
